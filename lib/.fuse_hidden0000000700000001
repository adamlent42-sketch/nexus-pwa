export function useCreateUpdateEmail() {
  const qc = useQueryClient();
  return useMutation({
    mutationFn: (body: unknown) => postJson<{ id: string }>("/api/update-email-requests", body),
    onSuccess: () => {
      qc.invalidateQueries({ queryKey: ["update-emails"] });
      qc.invalidateQueries({ queryKey: ["admin", "student-outreach"] });
      // Lead Follow-up tab tracks pending update requests so its "Draft email"
      // button disables once one is queued.
      qc.invalidateQueries({ queryKey: ["admin", "lead-outreach"] });
    }
  });
}

