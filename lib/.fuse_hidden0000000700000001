"use client";

import { useMutation, useQueryClient } from "@tanstack/react-query";

interface ApiOk<T> { ok: true; data: T }
interface ApiErr { ok: false; error: string }
type ApiResp<T> = ApiOk<T> | ApiErr;

async function postJson<T>(url: string, body: unknown, method: "POST" | "PATCH" = "POST"): Promise<T> {
  const res = await fetch(url, {
    method,
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body)
  });
  const json = (await res.json()) as ApiResp<T>;
  if (!json.ok) throw new Error(json.error);
  return json.data;
}

export function useCreateStaffAlert() {
  const qc = useQueryClient();
  return useMutation({
    mutationFn: (body: unknown) => postJson<{ id: string }>("/api/alerts", body),
    onSuccess: () => qc.invalidateQueries({ queryKey: ["alerts"] })
  });
}

export function useUpdateStaffAlert() {
  const qc = useQueryClient();
  return useMutation({
    mutationFn: ({ id, ...body }: { id: string } & Record<string, unknown>) =>
      postJson<{ id: string }>(`/api/alerts/${id}`, body, "PATCH"),
    onSuccess: () => qc.invalidateQueries({ queryKey: ["alerts"] })
  });
}

