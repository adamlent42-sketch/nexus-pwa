# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Airtable API access — get a personal access token from https://airtable.com/create/tokens
# Scopes needed: data.records:read, data.records:write, schema.bases:read
# Restrict to base: Kumon CRM (appNL9MjcWDgMAsih)
AIRTABLE_PAT=

# Base ID — already filled in for Kumon CRM
AIRTABLE_BASE_ID=appNL9MjcWDgMAsih

# Owner-only passphrase that gates the /admin section.
# Set to a string you can share with yourself only. Staff don't need this.
APP_OWNER_PASSPHRASE=

# Invoice Ninja (read-only) — pulls the amount due at first class onto the
# onboarding checklist. Token: Settings > Account Management > Integrations >
# API Tokens. Leave blank to disable the integration entirely.
INVOICE_NINJA_TOKEN=
# Hosted cloud = https://invoicing.co ; self-hosted = your own base URL.
INVOICE_NINJA_URL=https://invoicing.co
